# ============================================================
# Настройки проекта. Читают и сервер (backend), и экран (frontend).
# Переменные окружения процесса важнее этого файла.
# ============================================================

# ---------- LLM (llama.cpp / любой OpenAI-совместимый сервер) ----------
# Адрес: либо host + port (+ path), либо LLM_BASE_URL целиком.
LLM_HOST=100.104.60.3
LLM_PORT=9292
LLM_PATH=/v1
# LLM_BASE_URL=http://100.104.60.3:9292/v1
LLM_MODEL=qwen3.8-27b-fast
LLM_API_KEY=
# true — не ходить в модель, отвечает заглушка (для проверки без сети)
LLM_MOCK=false
# Отключить «рассуждения» Qwen3 (быстрее, ответы чище)
LLM_DISABLE_THINKING=true
# Вызов инструментов на втором этапе. Для llama.cpp нужен запуск сервера с --jinja
LLM_TOOLS=true
# Сколько ждать один ответ модели, сек
LLM_TIMEOUT_SEC=120
LLM_MAX_TOKENS=1200
# Журнал запросов к модели в backend/data/llm.log (для настройки промптов)
LLM_LOG=true

# ---------- Картинки ----------
# Пусто — тот же host:port, что у LLM.
IMAGE_HOST=
IMAGE_PORT=
IMAGE_PATH=
# IMAGE_BASE_URL=http://100.104.60.3:9292/v1
IMAGE_MODEL=qwen-image-2.1
# openai — POST /v1/images/generations; sdapi — POST /sdapi/v1/txt2img
IMAGE_API=openai
IMAGE_ENABLED=true
# Сколько ждать одну картинку, сек (генерация идёт в фоне, чат не блокирует)
IMAGE_TIMEOUT_SEC=1200
IMAGE_STEPS=

# Водяной знак на картинке, пока кампания не прошла модерацию
WATERMARK_ENABLED=true
WATERMARK_TEXT=ЧЕРНОВИК · НЕ ПРОШЛО МОДЕРАЦИЮ

# ---------- Порты приложения ----------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8080
FRONTEND_PORT=5173

# ---------- Прочее ----------
APP_TZ=Europe/Moscow
# Предел на весь ход ассистента (несколько вызовов модели), сек
TURN_TIMEOUT_SEC=300
# Сколько экран ждёт ответ, сек (чуть больше TURN_TIMEOUT_SEC)
VITE_TURN_TIMEOUT_SEC=330
# Путь к базе (по умолчанию backend/data/campaigns.db)
DB_PATH=
# true — экран работает без сервера (моки во frontend/src/mock)
VITE_USE_MOCK=false
